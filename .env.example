# ==============================================================================
# ChangoRadar (scraper-precios) — Variables de Entorno (.env)
# Copiá este archivo a .env solo si necesitás personalizar parámetros:
#   cp .env.example .env
#
# Para uso 100% LOCAL (CLI, DuckDB SQL y Web App/PWA), NO necesitás nube ni claves.
# ==============================================================================

# ── Lakehouse Local (Bronze / Silver / Gold en Parquet) ──────────────────────
SCRAPER_DATA_DIR=data/scraper-precios
SCRAPER_WEB_DIR=web
SCRAPER_OUTPUT_FORMAT=parquet

# ── Rate Limiting y Resiliencia por Supermercado ─────────────────────────────
SCRAPER_MAX_CONCURRENT_REQUESTS=4
SCRAPER_REQUEST_DELAY_SECONDS=0.4
SCRAPER_MAX_RETRIES=3
SCRAPER_CIRCUIT_BREAKER_THRESHOLD=3
SCRAPER_CARRY_FORWARD_MAX_DAYS=7

# ── Servidor Web Local / Contenedor ──────────────────────────────────────────
# 8001 (puerto fijo) o 0 (puerto dinámico automático)
SCRAPER_PORT=8001

# ── Tiendas y Canasta por Defecto ────────────────────────────────────────────
SCRAPER_ENABLED_STORES=carrefour,coto,dia,jumbo,disco,vea
SCRAPER_BASKET_TYPE=extended

# ── Seguridad Opcional (acceso abierto por defecto) ──────────────────────────
SCRAPER_REQUIRE_AUTH=false
SCRAPER_API_KEY=

# ── Google Cloud Platform (100% Opcional — requiere instalar extra `[gcp]`) ──
GCP_PROJECT_ID=my-gcp-project-id
GCP_REGION=us-central1
GCS_BUCKET_NAME=my-gcp-project-id-supermarket-lakehouse
GOOGLE_APPLICATION_CREDENTIALS=/ruta/a/service-account.json
